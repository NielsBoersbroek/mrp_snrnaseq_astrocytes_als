## Ignore data folders --------------------------------------------------


# No data should ever be pushed to remote, as it contains sensitive patient information,
# so let git ignore all files in the three possible data folders.
# However, I would still like to have the empty data folders present in my remote
# repo for aesthetic reasons, so place .gitkeep in the folders
/data/processed/*
!/data/processed/.gitkeep
/data/raw/*
!/data/raw/.gitkeep
/data/temporary/*
!/data/temporary/.gitkeep
# The exon junction data gets its own dedicated folder in /data/raw (required
# for loading in with load10X() function), which I want to keep with .gitkeep
!/data/raw/longread/
/data/raw/longread/*
!/data/raw/longread/.gitkeep


## Ignore result folders ------------------------------------------------


# Figures, tables and reports created via results should not be pushed to remote
# either, but I would also like to keep them as empty folders.
/results/figures/*
!/results/figures/.gitkeep
!/results/figures/manuscript/
/results/figures/manuscript/*
!/results/figures/manuscript/.gitkeep
/results/tables/*
!/results/tables/.gitkeep
/results/reports/*
!/results/reports/.gitkeep


## Ignore quarto-site files ---------------------------------------------


# Creating a quarto site produces some folders which produce output I do
# want to commit to Git
/_freeze/
/.quarto/
/_site/


## Ignore other files ---------------------------------------------------


# I use VS code and have a json set with specific settings, but these do not have to
# present in the remote repo
/.vscode/settings.json
**/*.quarto_ipynb
# For the slurm jobs, I provided my directory in config.sh - but this is my
# personal directory, so it should not actually be put into the repo; anyone using
# this repo should add his/her/their own directory as in config_example.sh
/slurm/config.sh
# SLURM output and error files are put into logs, anything there can be ignored as well
/logs/*
!/logs/.gitkeep