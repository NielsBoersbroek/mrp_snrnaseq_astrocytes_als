## Ignore data folders --------------------------------------------------


# No data should ever be pushed to remote, as it contains sensitive patient information,
# so let git ignore all files in the three possible data folders.
# However, I would still like to have the empty data folders present in my remote
# repo for aesthetic reasons, so place .gitkeep in the folders
/data/processed/*
!/data/processed/.gitkeep
/data/raw/*
!/data/raw/.gitkeep
/data/temporary/*
!/data/temporary/.gitkeep


## Ignore result folders ------------------------------------------------


# Figures, tables and reports created via results should not be pushed to remote
# either, but I would also like to keep them as empty folders.
/results/figures/*
!/results/figures/.gitkeep
!/results/figures/manuscript/.gitkeep
/results/tables/*
!/results/tables/.gitkeep
/results/reports/*
!/results/reports/.gitkeep



## Ignore other files ---------------------------------------------------


# I use VS code and have a json set with specific settings, but these do not have to
# present in the remote repo
/.vscode/settings.json